{
  "name": "scrollkit",
  "version": "0.1.0",
  "description": "Turn a video into a scroll / mouse / hover driven frame animation for websites",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "trunjeee",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.5",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "electron": "^44.9.1"
  },
  "productName": "ScrollKit",
  "build": {
    "appId": "at.trj.scrollkit",
    "productName": "ScrollKit",
    "files": [
      "src/**",
      "runtime/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "files": [
        "!**/node_modules/ffprobe-static/bin/{win32,linux}/**"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "files": [
        "!**/node_modules/ffprobe-static/bin/{darwin,linux}/**"
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}